#PSEUDO  CODE FOR FACTORIAL CALCULATOR 

BEGIN
            Read n
    
            IF n < 0 THEN
                PRINT "Error: Number must be positive"
                RETURN
            END IF
    
            IF n = 0 OR n = 1 THEN
                RETURN 1
            END IF
    
                ELSE
                RETURN n * FACTORIAL(n - 1)
            END ELSE
END
